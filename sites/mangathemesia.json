        "item": ".grid > a[href*=manga], .flex-wrap.flex a[href*=manga]",
        "next": "a:has(img[alt=Next])",
        "details": "body",
        "title": ".comic-title-content",
        "cover": "img[alt=poster]",
        "description": ".comic-content.mobile",
