        "chapterName": ".text-sm.text-white",
        "chapterDate": ".text-xs:not(:has(span))",
        "pages": "div > img.object-cover.mx-auto",
        "genreList": ".filter-dropdown-container label:has(input[name*=genres])"
      },
      "adult": true
    }
  },
